<% content_for :title, "ブランド一覧（一般ユーザー向け）" %>
<h1>ブランド一覧（一般ユーザー向け）</h1>

<!-- ブランドカード表示（一般ユーザー用） -->
<div class="grid general-user-brand-index">
  <% @brands.each do |brand| %>
    <div class="card general-card">
      <div class="h3">
        <%= link_to brand.name, brand_path(brand) %>
      </div>
    </div>
  <% end %>
</div>
<%= link_to '全店舗一覧', stores_path %>
<%= link_to '管理者専用ページ', admin_root_path %>